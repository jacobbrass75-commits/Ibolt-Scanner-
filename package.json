{
  "name": "iboltscan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild scripts/backup.ts scripts/restore.ts scripts/manage-user.ts scripts/import-catalog.ts scripts/pull-backup.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/scripts",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "scanner:test": "node scripts/scanner-test.mjs",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "user": "tsx scripts/manage-user.ts"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "better-sqlite3": "12.6.2",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "fast-xml-parser": "5.11.1",
    "jszip": "3.10.1",
    "lucide-react": "0.453.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.21",
    "@types/node": "22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.6.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}

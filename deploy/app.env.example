APP_MODE=production
HOST=127.0.0.1
PORT=5010
DATABASE_PATH=/var/lib/iboltscan/inventory.sqlite
BACKUP_DIR=/var/backups/iboltscan
PUBLIC_ORIGIN=https://iboltscan.com

# Fill both from the existing Ibolt production Clerk application.
# Store the secret only in the protected server environment, never in Git.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Standard Clerk DNS uses clerk.iboltscan.com; leave CLERK_PROXY_URL unset.
# Do not enable AUTH_USERS_FILE alongside Clerk authentication.

# Optional temporary warehouse link. Set both; never put a real token in Git.
WAREHOUSE_ACCESS_TOKEN_SHA256=
WAREHOUSE_ACCESS_EXPIRES_AT=
